general {
    output_format = "i3bar"
        colors = true
        color_good = "#00ff00"
        color_degraded = "#00ffff"
        color_bad = "#ff0000"
        interval = 5
}

order += "ipv4"
order += "disk /"
#order += "run_watch VPNC"
#order += "path_exists VPN"
order += "ethernet hn0"
#order += "cpu_temperature 0"
#order += "cpu_temperature 1"
order += "cpu_usage"
order += "tztime local"


ethernet hn0 {
# if you use %speed, i3status requires the cap_net_admin capability
    format_up = "%ip"
        format_down = "down"
}

